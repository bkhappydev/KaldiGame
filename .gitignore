#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Gradle build output
/android/build/

# SQLite side files created when the bundled database is opened locally
*.db-shm
*.db-wal
*.db-journal

# Saved Play Store bundles (large binaries, never commit)
/release/

# Personal Claude Code permissions (project skills in .claude/skills are shared)
.claude/settings.local.json
